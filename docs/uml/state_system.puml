@startuml state_system
!include _style.iuml
title State machine — system lock (Controller)

[*] --> LOCKED : power-on / reset\n[outputs OFF, door closed]

state LOCKED : entry / show "LOCKED"
state LOCKED : gestures ignored (FR-SEC-02)
state UNLOCKED : entry / start 30 s timer
state UNLOCKED : confirmed gesture / execute action,\nrestart 30 s timer
state LOCKOUT : entry / start 30 s timer
state LOCKOUT : all cards refused

LOCKED --> UNLOCKED : card [UID in whitelist]\n/ denied_count = 0
LOCKED --> LOCKED : card [UID unknown]\n/ denied_count++, show "DENIED"
LOCKED --> LOCKOUT : card [UID unknown\nand denied_count == 3]
LOCKOUT --> LOCKED : 30 s elapsed\n/ denied_count = 0

UNLOCKED --> LOCKED : "stop" gesture
UNLOCKED --> LOCKED : card [UID in whitelist]
UNLOCKED --> LOCKED : 30 s without\nconfirmed gesture
@enduml
