@startuml sequence_rfid_unlock
!include _style.iuml
title Sequence — unlock with RFID card
autonumber

actor User
participant "RC522\n(SPI)" as RC
participant "rfid task" as R
participant "Controller" as C
participant "display task" as D
participant "PC app" as PC

loop every 200 ms
  R -> RC : REQA / anticollision (SPI)
  RC --> R : no card
end
User -> RC : taps card
R -> RC : REQA / anticollision (SPI)
RC --> R : UID = 4 bytes
R -> C : card_read(UID)
alt UID in whitelist and state == LOCKED
  C -> C : state = UNLOCKED,\nstart 30 s auto-lock timer
  C -> D : show "UNLOCKED"
  C --> PC : EVT_STATE_CHANGED (reason = RFID_OK)
else UID unknown
  C -> C : denied_count++
  C -> D : show "ACCESS DENIED" (2 s)
  C --> PC : EVT_STATE_CHANGED (reason = RFID_DENIED)
  opt denied_count == 3
    C -> C : state = LOCKOUT (30 s)
  end
end
@enduml
