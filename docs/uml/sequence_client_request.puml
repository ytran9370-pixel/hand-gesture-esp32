@startuml sequence_client_request
!include _style.iuml
title Sequence — GestureClient request with retry (FR-COM-06)
autonumber

participant "Application" as App
participant "GestureClient" as C
participant "FrameParser" as P
participant "ISerialPort" as Port
participant "ESP32-S3\n(or MockSerialPort)" as Dev

App -> C : getState()
loop attempt = 0 .. retries (max 3 attempts)
  C -> C : seq = nextSeq()  (1..255)
  C -> Port : write(encodeFrame(GET_STATE, seq))
  Port -> Dev : bytes over UART
  alt response arrives
    Dev --> Port : A5 5A 86 seq ... CRC
    C -> Port : read(timeout)
    C -> P : feed(byte) for each byte
    alt event frame (0x4x)
      C -> App : listener.onStateChanged(event)
    else CRC error or ERROR(CRC/BUSY)
      C -> C : retry
    else ERROR(LOCKED, LEN, ...)
      C --> App : throw DeviceError
    else response with matching seq
      C --> App : return SysState
    end
  else nothing within timeoutMs
    C -> C : timeouts++, retry
  end
end
C --> App : throw TimeoutError (all attempts failed)
@enduml
