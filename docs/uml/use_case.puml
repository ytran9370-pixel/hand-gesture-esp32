@startuml use_case
!include _style.iuml
title Hand Gesture ESP32 — Use cases
left to right direction

actor User
actor "Tester /\nDeveloper" as Tester
actor "Auto-lock\ntimer" as Timer

rectangle "Hand Gesture ESP32 system" {
  usecase "UC-01\nUnlock with RFID card" as UC1
  usecase "UC-02\nControl lights by gesture" as UC2
  usecase "UC-03\nOpen / close door by gesture" as UC3
  usecase "UC-04\nLock the system" as UC4
  usecase "UC-05\nMonitor status\n(OLED, PC screen)" as UC5
  usecase "UC-06\nRun diagnostics\n(self-test, stats, profile)" as UC6
  usecase "Recognise gesture\n(INT8 CNN + filter)" as REC
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
Timer --> UC4
Tester --> UC6

UC2 ..> REC : <<include>>
UC3 ..> REC : <<include>>
UC4 ..> REC : <<include>>\n(stop gesture)
@enduml
