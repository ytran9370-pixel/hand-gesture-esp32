@startuml sequence_gesture
!include _style.iuml
title Sequence — one image from webcam to light (system UNLOCKED)
autonumber

actor User
participant "PC app\n(C++)" as PC
participant "link_rx task\n(ESP32 core 0)" as RX
participant "worker task\n(ESP32 core 1)" as W
participant "GestureFilter" as F
participant "Controller" as C
participant "LEDs / servo" as OUT
participant "display task" as D

User -> PC : holds "palm" in front of webcam
PC -> PC : capture frame, crop hand,\nresize to 64x64 RGB
PC -> RX : INFER (seq n, 12 288 bytes)
note right of PC : ~134 ms on the wire
RX -> RX : parse bytes, check CRC
RX -> W : xQueueSend(work_q, frame)
activate W
W -> W : LUT + 9 layers INT8\n(<= 100 ms)
W -> F : update(class = palm, conf = 0.97)
alt same class 3 times, conf >= 0.8, not in cooldown
  F --> W : CONFIRMED(palm)
  W -> C : execute(palm)
  C -> OUT : LED1..3 = ON
  C -> D : xQueueOverwrite(mailbox, state)
  C --> PC : EVT_STATE_CHANGED (reason = GESTURE)
else not yet confirmed
  F --> W : PENDING(count)
end
W --> PC : INFER response (seq n):\nclass, conf, action, logits
deactivate W
PC -> PC : draw gesture, confidence,\nlatency, FPS
D -> D : redraw OLED over I2C\n(low priority, never blocks inference)
@enduml
